# Environment variables for local development
# Copy this to .env and fill values as appropriate. Do NOT commit secrets.

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reframe_db

# Storage provider
# Options: local | s3
STORAGE_PROVIDER=local
# If STORAGE_PROVIDER=local, files are written to STORAGE_LOCAL_ROOT
STORAGE_LOCAL_ROOT=.local-storage

# If using S3-compatible storage, configure these:
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# AI mode: mock (default) or real
# mock: uses built-in sample responses for development (no external API keys required)
AI_MODE=mock

# Optional AI provider keys (only required in non-mock mode)
OCR_API_KEY=
SEGMENTATION_API_KEY=
INPAINTING_API_KEY=
IMAGE_GENERATION_API_KEY=

# Redis (optional, used for job queue in later phases)
REDIS_URL=redis://localhost:6379

# App configuration
NEXT_PUBLIC_APP_NAME=Reframe

# Upload limits and safety knobs
MAX_UPLOAD_BYTES=20971520 # 20MB

# Debugging
# Set to true to enable verbose server logs in development
DEV_VERBOSE_LOGS=true
